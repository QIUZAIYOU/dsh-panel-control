{
  "name": "dsh-panel-control",
  "version": "0.3.12",
  "type": "module",
  "description": "Manage the global panel navigation at the top of the DSH sidebar: reorder, hide and group every entry, with the layout persisted per installation.",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "sidebar",
    "panel"
  ],
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./icon": "./icon.svg"
  },
  "files": [
    "LICENSE",
    "README.md",
    "assets",
    "client.js",
    "cordis.patch.yml",
    "docs",
    "icon.svg",
    "index.js",
    "screenshots.json"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": []
    }
  },
  "license": "MIT",
  "author": {
    "name": "QIUZAIYOU"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/QIUZAIYOU/dsh-panel-control.git"
  },
  "homepage": "https://github.com/QIUZAIYOU/dsh-panel-control#readme",
  "bugs": {
    "url": "https://github.com/QIUZAIYOU/dsh-panel-control/issues"
  },
  "scripts": {
    "check": "node --check index.js && node --check client.js && node scripts/host-smoke.mjs",
    "smoke": "node scripts/host-smoke.mjs",
    "doctor": "node scripts/profile-doctor.mjs",
    "enable": "node scripts/enable-local.mjs"
  }
}
