{
  "name": "dsh-panel-control",
  "version": "0.10.4",
  "type": "module",
  "engines": {
    "dsh": ">=0.2.1-rc.3"
  },
  "description": "DeepSeek Harness 侧栏面板管理：排序、隐藏、分组、折叠与自动分类。",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "sidebar",
    "panel",
    "panel-manager",
    "sidebar-layout"
  ],
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./icon": "./icon.svg"
  },
  "files": [
    "LICENSE",
    "README.md",
    "assets",
    "client.js",
    "cordis.patch.yml",
    "docs",
    "icon.svg",
    "index.js",
    "screenshots.json",
    "scripts"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": []
    }
  },
  "license": "MIT",
  "author": {
    "name": "QIUZAIYOU"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/QIUZAIYOU/dsh-panel-control.git"
  },
  "homepage": "https://github.com/QIUZAIYOU/dsh-panel-control#readme",
  "bugs": {
    "url": "https://github.com/QIUZAIYOU/dsh-panel-control/issues"
  },
  "scripts": {
    "check": "node --check index.js && node --check client.js && node scripts/host-smoke.mjs && node scripts/layout-smoke.mjs && node scripts/bridge-smoke.mjs && node scripts/names-smoke.mjs",
    "smoke": "node scripts/host-smoke.mjs",
    "doctor": "node scripts/profile-doctor.mjs",
    "enable": "node scripts/enable-local.mjs"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  }
}
